# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgres://user:pass@host:5432/db

# Encryption
ENCRYPTION_KEY=change-this-to-a-32-byte-base64-key-in-production

# Stripe (required)
STRIPE_SECRET_KEY=sk_test_***
STRIPE_PUBLISHABLE_KEY=pk_test_***
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
PLATFORM_FEE_BPS=200

# Stripe Connect Custom Onboarding Toggles
# Set to true for embedded onboarding (recommended), false for account links (fallback)
STRIPE_EMBEDDED_ONBOARDING=true
# Set to true to use Financial Connections for bank account collection (optional)
STRIPE_FINANCIAL_CONNECTIONS=false

# App URLs
APP_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Session
SESSION_SECRET=change-this-in-production

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="DirectTip <noreply@directtip.app>"
